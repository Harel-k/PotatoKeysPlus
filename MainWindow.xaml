<Window x:Class="PotatoKeysPlus.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Potato Keys+" Width="980" Height="680" MinWidth="760" MinHeight="480"
        Icon="Assets/PotatoKeysPlus.ico"
        WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="46" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="46"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Title bar -->
    <Grid Grid.Row="0" Background="{StaticResource PanelBrush}">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
        <Canvas Width="30" Height="28">
          <Ellipse Canvas.Left="1" Canvas.Top="4" Width="26" Height="19" Fill="#C98F55" Stroke="#8A5A2E" StrokeThickness="1.3"
                   RenderTransformOrigin="0.5,0.5">
            <Ellipse.RenderTransform><RotateTransform Angle="-18"/></Ellipse.RenderTransform>
          </Ellipse>
          <Ellipse Canvas.Left="7" Canvas.Top="12" Width="2.6" Height="2.6" Fill="#7A4E26"/>
          <Ellipse Canvas.Left="13" Canvas.Top="8" Width="2.2" Height="2.2" Fill="#7A4E26"/>
          <Ellipse Canvas.Left="12" Canvas.Top="16" Width="2.2" Height="2.2" Fill="#7A4E26"/>
          <Border Canvas.Left="17" Canvas.Top="14" Width="13" Height="13" CornerRadius="6.5" Background="{StaticResource AccentBrush}"
                  BorderBrush="{StaticResource PanelBrush}" BorderThickness="1.5">
            <TextBlock Text="+" FontSize="11" FontWeight="Black" Foreground="{StaticResource OnAccentBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
          </Border>
        </Canvas>
        <TextBlock Text="Potato Keys" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0"/>
        <TextBlock Text="+" FontSize="17" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="1,-3,0,0"/>
      </StackPanel>

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Border x:Name="MouseModePill" Visibility="Collapsed" Background="{StaticResource AccentDimBrush}"
                BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="11" Padding="10,3"
                VerticalAlignment="Center" Margin="0,0,10,0">
          <TextBlock Text="MOUSE MODE ON" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
        </Border>
        <Button x:Name="CompactButton" AutomationProperties.Name="Compact widget" Style="{StaticResource TitleButton}" Content="&#xE73F;" ToolTip="Shrink to a mini widget" Click="CompactButton_Click"/>
        <ToggleButton x:Name="PinButton" AutomationProperties.Name="Pin window" Style="{StaticResource TitleToggle}" Content="&#xE718;" ToolTip="Pin on top of every window" Checked="PinButton_Changed" Unchecked="PinButton_Changed"/>
        <Button Style="{StaticResource TitleButton}" Content="&#xE921;" ToolTip="Minimize" Click="Minimize_Click"/>
        <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" ToolTip="Close Potato Keys+" Click="Close_Click"/>
      </StackPanel>
    </Grid>

    <!-- Full view: modules sidebar + page -->
    <Grid x:Name="FullView" Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="232"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,1,1,0">
        <DockPanel Margin="10,16,10,14">
          <TextBlock x:Name="VersionText" DockPanel.Dock="Bottom" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="10,0"/>
          <TextBlock DockPanel.Dock="Top" Text="MODULES" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="SemiBold" Margin="10,0,0,8"/>
          <ListBox x:Name="ModuleList" Background="Transparent" BorderThickness="0" SelectionChanged="ModuleList_SelectionChanged"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
        </DockPanel>
      </Border>

      <DockPanel Grid.Column="1">
        <!-- Shown when a new version is available -->
        <Border x:Name="UpdateBanner" DockPanel.Dock="Top" Visibility="Collapsed" Background="{StaticResource AccentDimBrush}"
                BorderBrush="{StaticResource AccentBrush}" BorderThickness="0,1,0,1" Padding="30,10">
          <DockPanel>
            <Button x:Name="UpdateBannerButton" DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Padding="14,6"
                    Content="Update now" Click="UpdateBannerButton_Click"/>
            <TextBlock x:Name="UpdateBannerText" VerticalAlignment="Center" FontWeight="SemiBold"
                       Foreground="{StaticResource AccentHoverBrush}" TextTrimming="CharacterEllipsis"/>
          </DockPanel>
        </Border>
        <ScrollViewer x:Name="PageScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,1,0,0">
          <ContentControl x:Name="PageHost" Margin="30,24,30,30" MaxWidth="940"/>
        </ScrollViewer>
      </DockPanel>
    </Grid>

    <!-- Compact widget view -->
    <Border x:Name="CompactView" Grid.Row="1" Visibility="Collapsed" Padding="14,12,14,14"
            BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,1,0,0">
      <StackPanel x:Name="CompactPanel"/>
    </Border>
  </Grid>
</Window>
